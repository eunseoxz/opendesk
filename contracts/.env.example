# Copy to .env locally. Never commit .env.
# Decrypt the project keystore into PRIVATE_KEY only in the shell, then unset.
# PRIVATE_KEY=
# Optional. If unset, DeployMainnet defaults both to the deployer address.
# TREASURY=
# OPERATOR=
# BSC_RPC=https://bsc-dataseed.binance.org
# Optional, only for forge verify-contract
# BSCSCAN_API_KEY=
